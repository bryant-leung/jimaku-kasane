# Copy to .env and fill in. Never commit .env.

# --- Subtitle sources ---
# https://jimaku.cc → account → API key
JIMAKU_API_KEY=
JIMAKU_BASE_URL=https://jimaku.cc/api
ANILIST_GRAPHQL_URL=https://graphql.anilist.co

# --- Local server (phase 3) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
# Extension origin allowed by CORS (chrome-extension://<id>)
ALLOWED_ORIGIN=

# --- ASR ---
# tiny | base | small | medium | large-v3 | kotoba-tech/kotoba-whisper-v2.0
WHISPER_MODEL=small
WHISPER_DEVICE=auto          # cpu | cuda | mps | auto

# --- LLM (correction / gloss) ---
LLM_PROVIDER=anthropic       # anthropic | openai | ollama
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- LangSmith tracing (optional, useful for learning LangGraph) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jp-sub-overlay
